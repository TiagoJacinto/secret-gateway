{
  "name": "secret-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Local masking gateway between Claude Code and the Anthropic Messages API",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "exempt": "bun run src/exempt.ts",
    "detect": "bun run src/detect-cli.ts",
    "check:secrets": "gitleaks detect --redact --exit-code 1 --no-banner --log-opts=--all"
  }
}
