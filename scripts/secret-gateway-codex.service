[Unit]
Description=Secret masking gateway for Codex Responses
After=network-online.target

[Service]
WorkingDirectory=/home/tiago/.t3/worktrees/secret-gateway/t3-c0af0a97
Environment=PATH=/home/tiago/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=PORT=8788
Environment=GATEWAY_PROTOCOL=responses
Environment=UPSTREAM_BASE_URL=https://chatgpt.com/backend-api/codex
Environment=GATEWAY_DATA_DIR=/home/tiago/.local/share/secret-gateway-codex
ExecStart=/home/tiago/.bun/bin/bun run start
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
